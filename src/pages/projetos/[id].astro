---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import Galeria from '../../components/Galeria.astro';
import galerias from '../../galerias.json';

export async function getStaticPaths() {
  const projetos = (await getCollection('projetos')).filter((p) => !p.data.rascunho);
  return projetos.map((projeto) => ({ params: { id: projeto.id }, props: { projeto } }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;

const acervo = (galerias as Record<string, any[]>)[projeto.id] ?? [];

// alguns projetos têm material gráfico digitalizado além das fotos
const CHAVE_MATERIAL: Record<string, string> = {
  'i-festival-diversidade-cultural': 'material-i-festival',
  'ii-festival-diversidade-cultural': 'material-ii-festival',
  'historia-da-musica': 'material-historia-da-musica',
  'palestra-arena-virtual': 'material-palestra-arena-virtual',
};
const chaveMaterial = CHAVE_MATERIAL[projeto.id];
const DESCRICAO_MATERIAL: Record<string, string> = {
  'historia-da-musica': 'Artes de divulgação do projeto, usadas nas redes sociais e nas escolas.',
  'palestra-arena-virtual': 'O convite distribuído pela associação para a palestra.',
};
const descricaoMaterial = DESCRICAO_MATERIAL[projeto.id]
  ?? 'Programa, expositores e patrocinadores da edição — peças originais do evento, digitalizadas.';
const material = chaveMaterial ? (galerias as Record<string, any[]>)[chaveMaterial] ?? [] : [];
---

<Base titulo={d.titulo} descricao={d.resumo}>
  <article>
    {d.capa && (
      <figure class="capa">
        <picture>
          <source media="(min-width: 900px)" srcset={`/capas/${d.capa.arquivo}.webp`} />
          <img src={`/capas/${d.capa.arquivo}-mobile.webp`} alt={d.capa.alt} width="1600" height="1200" />
        </picture>
      </figure>
    )}

    <header class="topo" data-com-capa={d.capa ? '' : undefined}>
      <div class="wrap">
        <p class="voltar"><a href="/projetos/">← Todos os projetos</a></p>
        <div class="topo__meta">
          <span class="etiqueta">{d.eixo}</span>
          <span class="topo__situacao" data-situacao={d.situacao}>{d.situacao}</span>
        </div>
        <h1>{d.titulo}</h1>
        <p class="topo__periodo">{d.periodo}</p>
      </div>
    </header>

    {d.numeros.length > 0 && (
      <section class="faixa">
        <div class="wrap">
          <ul class="numeros">
            {d.numeros.map((n) => (
              <li><strong>{n.valor}</strong><span>{n.rotulo}</span></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="secao">
      <div class="wrap">
      <div class="prosa corpo">
        <Content />
      </div>
    </div>
  </section>

    {d.video && (
      <section class="secao video">
        <div class="wrap">
          <p class="olho">Assista</p>
          <h2>{d.video.titulo}</h2>
          <div class="video__moldura">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${d.video.youtube}`}
              title={d.video.titulo}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>
    )}

    {acervo.length > 0 && (
      <Galeria
        fotos={acervo}
        pasta={projeto.id}
        titulo="Galeria"
        descricao="Registros do acervo da associação. Clique em qualquer imagem para ampliar."
      />
    )}

    {material.length > 0 && (
      <Galeria
        fotos={material}
        pasta={chaveMaterial}
        titulo="Material de divulgação"
        descricao={descricaoMaterial}
      />
    )}

    {d.instagram && (
      <section class="secao acompanhe">
        <div class="wrap">
          <p class="olho">Acompanhe</p>
          <h2>{d.instagram.titulo}</h2>
          <p class="acompanhe__texto">
            As aulas, os ensaios e as apresentações são publicados no perfil do projeto.
          </p>
          <p>
            <a class="btn" href={d.instagram.url} rel="noopener">
              Seguir {d.instagram.nome} no Instagram
            </a>
          </p>
        </div>
      </section>
    )}

    {d.creditos.length > 0 && (
      <section class="secao secao--suave">
        <div class="wrap">
          <h2>Ficha técnica</h2>
          <dl class="creditos">
            {d.creditos.map((c) => (
              <div class="credito">
                <dt>{c.papel}</dt>
                <dd>{c.quem}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .topo { background: var(--papel-suave); padding-block: clamp(2.5rem, 6vw, 4rem); border-bottom: 1px solid var(--linha); }

  /* Capa em cor cheia — projeto em andamento pede presença, não sobriedade.
     Fica antes do título, com o voltar sobreposto para não perder a navegação. */
  .capa { margin: 0; line-height: 0; background: var(--marinho); }
  .capa img { width: 100%; height: auto; display: block; }
  .topo[data-com-capa] { border-top: 4px solid var(--azul-principal); }
  .voltar { font-size: 0.9rem; margin-bottom: 1.4rem; }
  .voltar a { text-decoration: none; }
  .topo__meta { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .etiqueta {
    font-family: var(--fonte-titulo); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase;
    background: #EDF0FF; color: var(--azul-escuro);
    padding: 0.32em 0.7em; border-radius: 99px;
  }
  .topo__situacao { font-size: 0.85rem; color: var(--tinta-suave); }
  .topo__situacao[data-situacao='Ativo'] { color: #1C7A4B; font-weight: 600; }
  .topo h1 { max-width: 22ch; }
  .topo__periodo { color: var(--tinta-suave); margin: 0; }

  .faixa { background: var(--marinho); padding-block: 2.25rem; }
  .numeros { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2.75rem; }
  .numeros strong {
    display: block; font-family: var(--fonte-titulo); font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 2.75rem); color: #fff; line-height: 1;
  }
  .numeros span { display: block; margin-top: 0.4rem; color: #C9D3FF; font-size: 0.92rem; }

  .corpo :global(h2) { margin-top: 2rem; }
  .corpo :global(strong) { color: var(--marinho); }

  .video__moldura {
    position: relative; width: 100%; max-width: 900px;
    aspect-ratio: 16 / 9; margin-top: 1.5rem;
    border-radius: var(--raio); overflow: hidden; background: var(--marinho);
  }
  .video__moldura iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .acompanhe { border-top: 1px solid var(--linha); }
  .acompanhe h2 { margin-bottom: 0.6rem; }
  .acompanhe__texto { color: var(--tinta-suave); max-width: 58ch; margin-bottom: 1.6rem; }

  .creditos { margin: 1.75rem 0 0; display: grid; gap: 1rem; max-width: 60ch; }
  .credito { display: grid; grid-template-columns: 11rem 1fr; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--linha); }
  .credito dt { font-family: var(--fonte-titulo); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--azul-escuro); }
  .credito dd { margin: 0; }
  @media (max-width: 600px) { .credito { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
