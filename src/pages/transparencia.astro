---
import Base from '../layouts/Base.astro';
import { ORG, GOVERNANCA } from '../dados';
import { PARCERIAS, DOCUMENTOS } from '../parcerias';

const cadastro = [
  { rotulo: 'Razão social', valor: ORG.razaoSocial },
  { rotulo: 'Nome fantasia', valor: ORG.sigla },
  { rotulo: 'CNPJ', valor: ORG.cnpj },
  { rotulo: 'Natureza jurídica', valor: ORG.natureza },
  { rotulo: 'Fundação', valor: ORG.fundacao },
  { rotulo: 'Registro do Estatuto', valor: ORG.registroEstatuto },
  { rotulo: 'Sede', valor: `${ORG.endereco} — ${ORG.cep}` },
];

const orgaos = [
  { nome: 'Conselho de Administração', membros: GOVERNANCA.conselhoAdministracao },
  { nome: 'Conselho Fiscal', membros: GOVERNANCA.conselhoFiscal },
  { nome: 'Diretoria Executiva', membros: GOVERNANCA.diretoriaExecutiva },
];
---

<Base
  titulo="Transparência"
  descricao="Dados cadastrais, composição dos conselhos e documentos institucionais da Associação de Cultura e Artes de Cajuru."
>
  <section class="topo">
    <div class="wrap">
      <p class="olho">Transparência</p>
      <h1>Quem responde pela associação</h1>
      <p class="topo__linha">
        Uma associação sem fins econômicos administra recursos públicos e privados destinados à
        cultura. Esta página reúne os dados que permitem verificar quem somos e como nos organizamos.
      </p>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <h2>Dados cadastrais</h2>
      <dl class="cadastro">
        {cadastro.map((c) => (
          <div class="linha">
            <dt>{c.rotulo}</dt>
            <dd>{c.valor}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="secao secao--suave" id="governanca">
    <div class="wrap">
      <h2>Governança</h2>
      <p class="prosa">
        A associação é administrada por um Conselho de Administração, fiscalizada por um Conselho
        Fiscal e executada por uma Diretoria Executiva.
      </p>
      <div class="grade grade--3 orgaos">
        {orgaos.map((o) => (
          <article class="orgao">
            <h3>{o.nome}</h3>
            <ul>
              {o.membros.map((m) => (
                <li>
                  <span class="orgao__nome">{m.nome}</span>
                  <span class="orgao__cargo">{m.cargo}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao" id="parcerias">
    <div class="wrap">
      <h2>Parcerias com a administração pública</h2>
      <p class="prosa">
        Divulgação obrigatória, nos termos do <strong>art. 11 da Lei nº 13.019/2014</strong>, do
        art. 80 do Decreto nº 8.726/2016 e do art. 63 do Decreto nº 7.724/2012. Estão listadas
        todas as parcerias celebradas pela associação com órgãos públicos, com ou sem repasse de
        recursos. A <a href="#governanca">relação nominal dos dirigentes</a> e o
        <a href="#documentos">Estatuto Social</a> constam nesta mesma página.
      </p>

      {PARCERIAS.map((p) => (
        <article class="parceria">
          <header class="parceria__topo">
            <h3>{p.instrumento}</h3>
            <p class="parceria__orgao">{p.orgaoCurto}</p>
          </header>

          <dl class="campos">
            <div class="campo">
              <dt>Data de assinatura</dt>
              <dd>
                {p.assinatura}
                {p.assinaturaNota && <span class="campo__nota">{p.assinaturaNota}</span>}
              </dd>
            </div>
            <div class="campo">
              <dt>Vigência</dt>
              <dd>{p.vigencia}</dd>
            </div>
            <div class="campo">
              <dt>Órgão responsável</dt>
              <dd>{p.orgao}<span class="campo__nota">CNPJ {p.orgaoCnpj}</span></dd>
            </div>
            <div class="campo">
              <dt>Organização da sociedade civil</dt>
              <dd>{ORG.razaoSocial}<span class="campo__nota">CNPJ {ORG.cnpj}</span></dd>
            </div>
            <div class="campo">
              <dt>Objeto</dt>
              <dd>{p.objeto}</dd>
            </div>
            <div class="campo">
              <dt>Valor total</dt>
              <dd><strong class="valor">{p.valorTotal}</strong></dd>
            </div>
            <div class="campo">
              <dt>Valores liberados</dt>
              <dd>{p.valorLiberado}</dd>
            </div>
            {p.identificacao.map((i) => (
              <div class="campo">
                <dt>{i.rotulo}</dt>
                <dd>{i.valor}</dd>
              </div>
            ))}
          </dl>

          {p.emenda && (
            <div class="bloco">
              <h4>Emenda parlamentar</h4>
              <p class="bloco__linha">
                Rastreabilidade da origem do recurso, conforme o entendimento firmado pelo
                Supremo Tribunal Federal na ADPF nº 854.
              </p>
              <dl class="campos campos--compacto">
                {p.emenda.map((e) => (
                  <div class="campo">
                    <dt>{e.rotulo}</dt>
                    <dd>{e.valor}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {p.publicacoes && (
            <div class="bloco">
              <h4>Publicação oficial</h4>
              <p class="bloco__linha">
                Os dados acima podem ser conferidos contra os extratos publicados pelo próprio
                poder público.
              </p>
              <ul class="pubs">
                {p.publicacoes.map((pb) => (
                  <li>
                    <a href={pb.url} target="_blank" rel="noopener">
                      <strong>{pb.rotulo}</strong>
                      <span>{pb.valor}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {p.planoTrabalho && (
            <div class="bloco">
              <h4>Plano de trabalho</h4>
              <p class="bloco__linha">
                Rubricas previstas. As marcadas como <em>equipe</em> compõem a remuneração da equipe
                de trabalho paga com recursos da parceria — art. 11, VI, da Lei 13.019/2014 e art. 80
                do Decreto 8.726/2016. Total destinado à equipe: <strong>{p.equipeTotal}</strong>.
              </p>
              <table class="tabela">
                <thead>
                  <tr><th>Rubrica</th><th class="num">Valor previsto</th></tr>
                </thead>
                <tbody>
                  {p.planoTrabalho.map((r) => (
                    <tr data-equipe={r.equipe ? '' : undefined}>
                      <td>{r.item}{r.equipe && <span class="marca">equipe</span>}</td>
                      <td class="num">{r.valor}</td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr><td>Total</td><td class="num">{p.valorTotal}</td></tr>
                </tfoot>
              </table>
            </div>
          )}

          <div class="bloco">
            <h4>Situação da prestação de contas</h4>
            <dl class="campos campos--compacto">
              {p.prestacaoContas.map((c) => (
                <div class="campo">
                  <dt>{c.rotulo}</dt>
                  <dd>{c.valor}</dd>
                </div>
              ))}
            </dl>
          </div>

          {p.observacao && <p class="parceria__nota">{p.observacao}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="secao secao--suave" id="documentos">
    <div class="wrap">
      <div class="prosa">
      <h2>Documentos institucionais</h2>
      <p>
        Instrumentos e peças das parcerias, em PDF. O Estatuto Social, as atas de assembleia e as
        prestações de contas da associação seguem em organização para publicação aqui.
      </p>
      </div>

      <ul class="docs">
        {DOCUMENTOS.map((d) => (
          <li>
            <a href={`/documentos/${d.arquivo}`} target="_blank" rel="noopener">
              <span class="docs__icone" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M13.5 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                  <path d="M13.5 2.5V8H19" />
                </svg>
              </span>
              <span class="docs__texto">
                <strong>{d.titulo}</strong>
                <span class="docs__descricao">{d.descricao}</span>
                <span class="docs__meta">PDF · {d.tamanho}</span>
              </span>
              <span class="docs__seta" aria-hidden="true">↓</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="prosa">
      <p class="docs__aviso">
        Documentos que contêm dados pessoais de terceiros — CPF, RG, endereço residencial ou
        telefone — não são publicados. As informações que a lei exige deles aparecem acima,
        extraídas sem expor ninguém. Outros documentos podem ser pedidos pelo e-mail{' '}
        <a href={`mailto:${ORG.email}`}>{ORG.email}</a>.
      </p>

      <h2>Proteção de dados</h2>
      <p>
        A associação lida com dados pessoais de crianças, artistas e associados. Como tratamos
        essas informações, com quem as compartilhamos e o que você pode exigir de nós está
        descrito em documento próprio.
      </p>
      <p><a class="btn" href="/privacidade/">Política de privacidade e proteção de dados</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .topo { background: var(--papel-suave); padding-block: clamp(3rem, 7vw, 4.75rem); border-bottom: 1px solid var(--linha); }
  .topo h1 { max-width: 20ch; }
  .topo__linha { font-size: 1.08rem; color: var(--tinta-suave); max-width: 64ch; margin-top: 1rem; }

  .cadastro { margin: 1.75rem 0 0; display: grid; gap: 0; max-width: 78ch; }
  .linha { display: grid; grid-template-columns: 15rem 1fr; gap: 1.5rem; padding: 0.95rem 0; border-bottom: 1px solid var(--linha); }
  .linha dt { font-family: var(--fonte-titulo); font-weight: 600; font-size: 0.92rem; color: var(--azul-escuro); }
  .linha dd { margin: 0; }
  @media (max-width: 680px) { .linha { grid-template-columns: 1fr; gap: 0.2rem; } }

  .orgaos { margin-top: 2.5rem; }
  .orgao { background: #fff; border: 1px solid var(--linha); border-radius: var(--raio); padding: 1.6rem; }
  .orgao h3 { font-size: 1.05rem; color: var(--marinho); margin-bottom: 1.1rem; }
  .orgao ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.95rem; }
  .orgao__nome { display: block; font-weight: 600; font-size: 0.97rem; }
  .orgao__cargo { display: block; font-size: 0.87rem; color: var(--tinta-suave); }

  /* Parcerias — cada uma é um bloco fechado, com os campos que o art. 11 da
     Lei 13.019/2014 exige. A leitura é de fiscal: precisa achar o campo rápido. */
  .parceria {
    margin-top: 2.25rem; padding: clamp(1.5rem, 4vw, 2.25rem);
    background: #fff; border: 1px solid var(--linha);
    border-left: 4px solid var(--azul-principal); border-radius: var(--raio);
  }
  .parceria__topo { padding-bottom: 1.2rem; border-bottom: 1px solid var(--linha); margin-bottom: 0.5rem; }
  .parceria__topo h3 { font-size: clamp(1.1rem, 2.4vw, 1.3rem); color: var(--marinho); margin-bottom: 0.4rem; }
  .parceria__orgao { color: var(--tinta-suave); font-size: 0.95rem; margin: 0; max-width: 70ch; }
  .parceria__nota {
    margin: 1.4rem 0 0; padding-top: 1.2rem; border-top: 1px solid var(--linha);
    font-size: 0.92rem; color: var(--tinta-suave); max-width: 72ch;
  }

  .campos { margin: 0; display: grid; }
  .campo { display: grid; grid-template-columns: 17rem 1fr; gap: 1.5rem; padding: 0.95rem 0; border-bottom: 1px solid var(--linha); }
  .campo:last-child { border-bottom: 0; }
  .campo dt { font-family: var(--fonte-titulo); font-weight: 600; font-size: 0.86rem; color: var(--azul-escuro); }
  .campo dd { margin: 0; max-width: 78ch; }
  .campo__nota { display: block; font-size: 0.86rem; color: var(--tinta-suave); margin-top: 0.2rem; }
  .campos--compacto .campo { grid-template-columns: 20rem 1fr; }
  .valor { font-family: var(--fonte-titulo); font-size: 1.15rem; color: var(--azul-escuro); }
  @media (max-width: 760px) {
    .campo, .campos--compacto .campo { grid-template-columns: 1fr; gap: 0.25rem; }
  }

  .bloco { margin-top: 1.8rem; padding-top: 1.6rem; border-top: 1px solid var(--linha); }
  .bloco h4 {
    font-family: var(--fonte-titulo); font-size: 0.8rem; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--azul-escuro);
    margin-bottom: 0.7rem;
  }
  .bloco__linha { font-size: 0.92rem; color: var(--tinta-suave); max-width: 74ch; margin-bottom: 1.2rem; }

  .tabela { width: 100%; border-collapse: collapse; font-size: 0.93rem; }
  .tabela th, .tabela td { text-align: left; padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--linha); }
  .tabela th {
    font-family: var(--fonte-titulo); font-size: 0.76rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--azul-escuro);
  }
  .tabela .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .tabela tr[data-equipe] td:first-child { font-weight: 500; }
  .tabela tfoot td { font-weight: 700; color: var(--marinho); border-bottom: 0; border-top: 2px solid var(--linha); }
  .marca {
    display: inline-block; margin-left: 0.5rem;
    font-family: var(--fonte-titulo); font-size: 0.66rem; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    background: #EDF0FF; color: var(--azul-escuro);
    padding: 0.15em 0.5em; border-radius: 99px; vertical-align: 1px;
  }

  .pubs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .pubs a {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.8rem;
    padding: 0.7rem 0.9rem; border: 1px solid var(--linha); border-radius: 8px;
    text-decoration: none; background: var(--papel-suave);
    transition: border-color 0.18s ease;
  }
  .pubs a:hover { border-color: var(--azul-principal); }
  .pubs strong { font-family: var(--fonte-titulo); font-size: 0.93rem; color: var(--azul-escuro); }
  .pubs span { font-size: 0.88rem; color: var(--tinta-suave); }
  .pubs a::after { content: '↗'; margin-left: auto; color: var(--azul-escuro); }

  /* Documentos para download */
  .docs { list-style: none; margin: 1.75rem 0; padding: 0; display: grid; gap: 0.7rem; }
  .docs a {
    display: flex; align-items: flex-start; gap: 0.95rem;
    padding: 1.05rem 1.2rem; background: #fff;
    border: 1px solid var(--linha); border-radius: 10px; text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .docs a:hover { border-color: var(--azul-principal); transform: translateY(-1px); }
  .docs__icone {
    flex: none; width: 38px; height: 38px; display: grid; place-items: center;
    border-radius: 9px; background: #EDF0FF; color: var(--azul-escuro);
  }
  .docs__icone svg { width: 20px; height: 20px; }
  .docs__texto { display: grid; gap: 0.2rem; min-width: 0; }
  .docs__texto strong { font-family: var(--fonte-titulo); font-size: 0.98rem; color: var(--tinta); }
  .docs__descricao { font-size: 0.9rem; color: var(--tinta-suave); max-width: 68ch; }
  .docs__meta { font-size: 0.8rem; color: var(--tinta-suave); letter-spacing: 0.03em; }
  .docs__seta { margin-left: auto; color: var(--azul-escuro); font-size: 1.15rem; flex: none; }
  .docs__aviso { font-size: 0.92rem; color: var(--tinta-suave); max-width: 74ch; }
</style>
