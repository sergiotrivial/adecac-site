---
import Base from '../layouts/Base.astro';
import { ORG, EIXOS } from '../dados';
import { getCollection } from 'astro:content';

const projetos = (await getCollection('projetos'))
  .filter((p) => p.data.destaque)
  .sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base
  titulo="inicio"
  descricao="A ADECAC preserva a memória de Cajuru, forma novos artistas e celebra quem faz cultura na cidade. Associação de Cultura e Artes de Cajuru, sem fins econômicos, desde 2011."
>
  <section class="capa">
    <div class="wrap capa__interno">
      <p class="olho">Cajuru / SP · desde 2011</p>
      <h1>{ORG.missao}</h1>
      <p class="capa__linha">{ORG.missaoLonga}</p>
      <div class="capa__acoes">
        <a class="btn" href="/projetos/">Ver os projetos</a>
        <a class="btn btn--contorno" href="/quem-somos/">Quem somos</a>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <p class="olho">Como trabalhamos</p>
      <h2>Três eixos, um propósito</h2>
      <p class="prosa">
        Tudo o que a associação faz cabe em um destes três eixos. Eles não são novidade —
        estão no Estatuto desde 2011.
      </p>

      <div class="grade grade--3 eixos">
        {EIXOS.map((eixo, i) => (
          <article class="eixo">
            <span class="eixo__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{eixo.nome}</h3>
            <p class="eixo__resumo">{eixo.resumo}</p>
            <p class="eixo__detalhe">{eixo.detalhe}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--escura">
    <div class="wrap">
      <p class="olho">O que já foi feito</p>
      <h2>Números com lastro</h2>
      <div class="grade grade--3 numeros">
        <div class="numero"><strong>79</strong><span>jovens atendidos pelo projeto de música desde 2017</span></div>
        <div class="numero"><strong>~550</strong><span>pessoas nas duas edições do Festival da Diversidade Cultural</span></div>
        <div class="numero"><strong>61</strong><span>artistas locais no palco dos dois festivais</span></div>
      </div>
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="wrap">
      <p class="olho">Projetos</p>
      <h2>O que sustenta o trabalho</h2>
      <div class="grade grade--2 cards">
        {projetos.map((p) => (
          <article class="card">
            <div class="card__meta">
              <span class="etiqueta">{p.data.eixo}</span>
              <span class="card__situacao" data-situacao={p.data.situacao}>{p.data.situacao}</span>
            </div>
            <h3><a href={`/projetos/${p.id}/`}>{p.data.titulo}</a></h3>
            <p class="card__periodo">{p.data.periodo}</p>
            <p>{p.data.resumo}</p>
          </article>
        ))}
      </div>
      <p class="mais"><a href="/projetos/">Ver todos os projetos →</a></p>
    </div>
  </section>
</Base>

<style>
  .capa {
    background: linear-gradient(170deg, var(--marinho) 0%, #1B2454 62%, #24306B 100%);
    color: #fff;
    padding-block: clamp(4rem, 11vw, 8rem);
  }
  .capa h1 { color: #fff; max-width: 17ch; }
  .capa .olho { color: #9DB0FF; }
  .capa__linha {
    font-size: clamp(1.05rem, 2.1vw, 1.3rem);
    color: #C9D3FF; max-width: 54ch; margin-top: 1.4rem;
  }
  .capa__acoes { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.25rem; }
  .capa .btn--contorno { color: #fff; }
  .capa .btn--contorno:hover { background: #fff; color: var(--marinho); }

  .eixos { margin-top: 2.75rem; }
  .eixo { border-top: 3px solid var(--azul-principal); padding-top: 1.4rem; }
  .eixo__num {
    font-family: var(--fonte-titulo); font-size: 0.8rem; font-weight: 700;
    color: var(--azul-principal); letter-spacing: 0.1em;
  }
  .eixo h3 { margin: 0.4rem 0 0.6rem; font-size: 1.35rem; }
  .eixo__resumo { font-weight: 600; color: var(--tinta); }
  .eixo__detalhe { color: var(--tinta-suave); font-size: 0.96rem; }

  .numeros { margin-top: 2.5rem; }
  .numero strong {
    display: block; font-family: var(--fonte-titulo);
    font-size: clamp(2.6rem, 6vw, 3.6rem); font-weight: 700;
    color: #fff; line-height: 1;
  }
  .numero span { display: block; margin-top: 0.7rem; color: #C9D3FF; font-size: 0.97rem; max-width: 26ch; }

  .cards { margin-top: 2.5rem; }
  .card {
    background: #fff; border: 1px solid var(--linha);
    border-radius: var(--raio); padding: 1.75rem;
  }
  .card__meta { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.9rem; }
  .etiqueta {
    font-family: var(--fonte-titulo); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase;
    background: #EDF0FF; color: var(--azul-escuro);
    padding: 0.32em 0.7em; border-radius: 99px;
  }
  .card__situacao { font-size: 0.8rem; color: var(--tinta-suave); }
  .card__situacao[data-situacao='Ativo'] { color: #1C7A4B; font-weight: 600; }
  .card h3 { margin-bottom: 0.3rem; }
  .card h3 a { color: var(--tinta); text-decoration: none; }
  .card h3 a:hover { color: var(--azul-escuro); }
  .card__periodo { font-size: 0.88rem; color: var(--tinta-suave); margin-bottom: 0.8rem; }
  .mais { margin-top: 2rem; font-family: var(--fonte-titulo); font-weight: 600; }
  .mais a { text-decoration: none; }
</style>
