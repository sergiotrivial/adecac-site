---
/* Links de rede social com ícone e aparência de botão — usado no rodapé e na
   página de contato, para não repetir marcação nem divergir de estilo. */
import { ORG } from '../dados';

interface Props {
  variante?: 'claro' | 'escuro';
  incluirProjeto?: boolean;
}
const { variante = 'claro', incluirProjeto = false } = Astro.props;

const redes = [
  { nome: 'Instagram', rotulo: ORG.instagramNome, url: ORG.instagram, icone: 'instagram' },
  { nome: 'YouTube', rotulo: ORG.youtubeNome, url: ORG.youtube, icone: 'youtube' },
  { nome: 'Facebook', rotulo: 'adecaccajuru', url: ORG.facebook, icone: 'facebook' },
];

if (incluirProjeto) {
  redes.push({
    nome: 'Instagram do projeto',
    rotulo: ORG.instagramProjetoNome,
    url: ORG.instagramProjeto,
    icone: 'instagram',
  });
}
---

<ul class={`redes redes--${variante}`}>
  {redes.map((r) => (
    <li>
      <a href={r.url} rel="me noopener" target="_blank">
        <span class="redes__icone" aria-hidden="true">
          {r.icone === 'instagram' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.6" cy="6.4" r="1.15" fill="currentColor" stroke="none" />
            </svg>
          )}
          {r.icone === 'youtube' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <rect x="2" y="4.5" width="20" height="15" rx="4.2" />
              <path d="M10.2 9.1v5.8l5-2.9z" fill="currentColor" stroke="none" />
            </svg>
          )}
          {r.icone === 'facebook' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
              <path d="M14.6 21.5v-8.2h2.8l.5-3.3h-3.3V7.9c0-.95.3-1.6 1.7-1.6h1.7V3.4a24 24 0 0 0-2.6-.13c-2.6 0-4.3 1.6-4.3 4.4V10H8v3.3h3.1v8.2z" fill="currentColor" stroke="none" />
            </svg>
          )}
        </span>
        <span class="redes__texto">
          <strong>{r.nome}</strong>
          <span class="redes__conta">{r.rotulo}</span>
        </span>
        <span class="redes__seta" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .redes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }

  .redes a {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid var(--linha);
    background: #fff;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }
  .redes a:hover {
    border-color: var(--azul-principal);
    background: var(--papel-suave);
    transform: translateY(-1px);
  }

  .redes__icone {
    flex: none; width: 38px; height: 38px;
    display: grid; place-items: center;
    border-radius: 9px;
    background: #EDF0FF; color: var(--azul-escuro);
  }
  .redes__icone svg { width: 21px; height: 21px; }

  .redes__texto { display: grid; line-height: 1.3; min-width: 0; }
  .redes__texto strong {
    font-family: var(--fonte-titulo); font-size: 0.95rem; font-weight: 600;
    color: var(--tinta);
  }
  .redes__conta {
    font-size: 0.85rem; color: var(--tinta-suave);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .redes__seta { margin-left: auto; color: var(--azul-escuro); font-size: 1.05rem; }

  /* sobre fundo marinho, no rodapé */
  .redes--escuro a {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.16);
  }
  .redes--escuro a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
  }
  .redes--escuro .redes__icone { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .redes--escuro .redes__texto strong { color: #fff; }
  .redes--escuro .redes__conta { color: #9DB0FF; }
  .redes--escuro .redes__seta { color: #9DB0FF; }
</style>
