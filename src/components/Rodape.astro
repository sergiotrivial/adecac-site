---
import { ORG } from '../dados';
import Redes from './Redes.astro';
const ano = new Date().getFullYear();
---

<footer class="rod">
  <div class="wrap">
    <div class="rod__topo">
      <div class="rod__marca">
        <img src="/logos/ADECAC_institucional_branca.png" alt={ORG.razaoSocial} width="230" height="80" />
        <p class="rod__missao">{ORG.missao}</p>
      </div>

      <div class="rod__col">
        <h2>Contato</h2>
        <p>
          <a href={`mailto:${ORG.email}`}>{ORG.email}</a><br />
          <a href={`tel:${ORG.telefoneLink}`}>{ORG.telefone}</a>
        </p>
        <p>{ORG.endereco}<br />{ORG.cep}</p>
      </div>

      <div class="rod__col">
        <h2>Institucional</h2>
        <p>
          <a href="/quem-somos/">Quem somos</a><br />
          <a href="/projetos/">Projetos</a><br />
          <a href="/transparencia/">Transparência</a>
        </p>
        <div class="rod__redes"><Redes variante="escuro" /></div>
      </div>
    </div>

    <div class="rod__base">
      <p>{ORG.razaoSocial} — CNPJ {ORG.cnpj}</p>
      <p>© {ano} ADECAC. {ORG.slogan}</p>
    </div>
  </div>
</footer>

<style>
  .rod { background: var(--marinho); color: #fff; padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; }
  .rod__topo {
    display: grid; gap: 2.5rem;
    grid-template-columns: 1.4fr 1fr 1fr;
    padding-bottom: 2.5rem;
  }
  .rod__marca img { width: 230px; margin-bottom: 1.2rem; }
  .rod__missao {
    font-family: var(--fonte-titulo); font-size: 1.05rem; font-weight: 500;
    color: #C9D3FF; max-width: 30ch;
  }
  .rod__col h2 {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: #9DB0FF; margin-bottom: 1rem;
  }
  .rod__col p { font-size: 0.95rem; color: #D4DAF0; }
  .rod a { color: #fff; text-decoration: none; }
  .rod a:hover { text-decoration: underline; }
  .rod__redes { margin-top: 1.2rem; }
  .rod__redes :global(.redes) { gap: 0.5rem; }
  .rod__base {
    border-top: 1px solid rgba(255,255,255,0.16);
    padding-top: 1.75rem;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    font-size: 0.85rem; color: #9AA4C8;
  }
  .rod__base p { margin: 0; }
  @media (max-width: 800px) {
    .rod__topo { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
